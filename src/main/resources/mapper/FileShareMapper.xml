    <!-- 更新文件分享显示次数 -->
    <update id="updateShareShowCount">
        update file_share
        set show_count = show_count + 1
        where share_id = #{shareId,jdbcType=VARCHAR}
    </update>
    <!-- 批量删除文件分享 -->
    <delete id="deleteFileShareBatch">
